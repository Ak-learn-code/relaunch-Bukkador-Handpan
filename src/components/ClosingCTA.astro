---
interface Props { title?: string; text?: string; academy?: boolean; cta?: string; href?: string }
const { title = 'Lassen Sie uns über Ihr Event sprechen.', text = 'Teilen Sie die wichtigsten Eckdaten mit. Bukkador meldet sich mit einem individuellen Angebot.', academy = false, cta, href } = Astro.props;
const path = (value: string) => `${import.meta.env.BASE_URL}${value.replace(/^\//, '')}`;
---
<section class="closing-cta">
  <div class="shell closing-inner"><div><h2 data-reveal="fade-up">{title}</h2><p data-reveal="fade-up">{text}</p></div><a class="button button-gold" data-reveal="fade-up" href={href ?? (academy ? 'mailto:info@bukkador-handpan.de?subject=Anfrage%20Handpan%20Academy' : path('/kontakt/'))}>{cta ?? (academy ? 'Academy anfragen' : 'Event-Verfügbarkeit prüfen')} <span aria-hidden="true">↗</span></a></div>
</section>
