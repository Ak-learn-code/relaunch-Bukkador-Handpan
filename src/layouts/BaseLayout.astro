---
import '../styles/global.css';
import { site } from '../content/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  extraSchema?: Record<string, unknown>[];
}
const { title, description, image = '/images/michael-noll-wide.webp', noindex = false, extraSchema = [] } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = (value: string) => `${base}${value.replace(/^\//, '')}`;
const canonical = new URL(Astro.url.pathname, site.origin).toString();
const socialImage = new URL(path(image.includes('/placeholders/') ? '/images/michael-noll-wide.webp' : image), site.origin).toString();
const isHome = Astro.url.pathname === base;
const eventLinks = [
  { label: 'Corporate Events', href: '/corporate-events/', description: 'Firmenfeiern, Empfänge & Business Events' },
  { label: 'Hochzeiten', href: '/hochzeiten/', description: 'Trauung, Empfang & Dinner' },
  { label: 'Eventagenturen', href: '/eventagenturen/', description: 'Professioneller Live-Act für Produktionen' },
];
const eventPaths = eventLinks.map((item) => path(item.href));
const isEventPage = eventPaths.includes(Astro.url.pathname);
const socialLinks = [
  { label: 'Instagram', href: 'https://www.instagram.com/bukkador_handpan', icon: 'instagram' },
  { label: 'YouTube', href: 'https://www.youtube.com/@Bukkador_Handpan', icon: 'youtube' },
  { label: 'Spotify', href: 'https://open.spotify.com/artist/0TbeDNlnNt5uRC2gk3Z6am', icon: 'spotify' },
] as const;
const structuredData = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.origin, inLanguage: 'de-DE' },
  { '@context': 'https://schema.org', '@type': 'Person', name: site.artist, alternateName: site.name, jobTitle: 'Handpan-Artist', url: site.origin, email: site.email, telephone: site.phone, address: { '@type': 'PostalAddress', addressLocality: 'Worms', addressCountry: 'DE' } },
  ...extraSchema,
];
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#151814" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <title>{isHome ? title : `${title} | Bukkador Handpan`}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" href={path('/images/Original-Logo-Symbol.png')} />
    <link rel="preload" href={path('/fonts/montserrat-latin.woff2')} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    <header class="site-header">
      <div class="header-inner shell">
        <a class="brand" href={path('/')} aria-label="Bukkador Handpan – Startseite">
          <img src={path('/images/Original-Logo-Symbol.png')} alt="" width="54" height="54" />
          <span><strong>BUKKADOR</strong><small>HANDPAN</small></span>
        </a>
        <nav class="desktop-nav" aria-label="Hauptnavigation">
          <div class="events-menu" data-events-menu>
            <button class="events-trigger" type="button" aria-expanded="false" aria-controls="events-dropdown" aria-current={isEventPage ? 'page' : undefined}>Events <span class="events-chevron" aria-hidden="true"></span></button>
            <div class="events-dropdown" id="events-dropdown" role="menu" aria-label="Eventbereiche">
              {eventLinks.map((item) => <a href={path(item.href)} role="menuitem" aria-current={Astro.url.pathname === path(item.href) ? 'page' : undefined}><strong>{item.label}</strong><small>{item.description}</small></a>)}
            </div>
          </div>
          <a href={path('/referenzen/')} aria-current={Astro.url.pathname === path('/referenzen/') ? 'page' : undefined}>Aktuelle Termine &amp; Referenzen</a>
          <a href={path('/academy/')} aria-current={Astro.url.pathname === path('/academy/') ? 'page' : undefined}>Bukkador Academy</a>
          <a href={path('/ueber-bukkador/')} aria-current={Astro.url.pathname === path('/ueber-bukkador/') ? 'page' : undefined}>Über Bukkador</a>
        </nav>
        <a class="header-cta" href={path('/kontakt/')}>Event anfragen <span class="arrow-icon" aria-hidden="true"></span></a>
        <details class="mobile-nav">
          <summary aria-label="Menü"><span></span><span></span><span class="sr-only">Menü</span></summary>
          <nav aria-label="Mobile Navigation">
            <details class="mobile-events" open={isEventPage}>
              <summary aria-current={isEventPage ? 'page' : undefined}>Events <span aria-hidden="true">+</span></summary>
              <div>
                {eventLinks.map((item) => <a href={path(item.href)} aria-current={Astro.url.pathname === path(item.href) ? 'page' : undefined}>{item.label}</a>)}
              </div>
            </details>
            <a href={path('/referenzen/')} aria-current={Astro.url.pathname === path('/referenzen/') ? 'page' : undefined}>Aktuelle Termine &amp; Referenzen</a>
            <a href={path('/academy/')} aria-current={Astro.url.pathname === path('/academy/') ? 'page' : undefined}>Bukkador Academy</a>
            <a href={path('/ueber-bukkador/')} aria-current={Astro.url.pathname === path('/ueber-bukkador/') ? 'page' : undefined}>Über Bukkador</a>
            <a class="mobile-nav-cta" href={path('/kontakt/')}>Event anfragen <span class="arrow-icon" aria-hidden="true"></span></a>
          </nav>
        </details>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-main">
        <div>
          <a class="brand footer-brand" href={path('/')} aria-label="Bukkador Handpan – Startseite">
            <img src={path('/images/Original-Logo-Symbol.png')} alt="" width="64" height="64" loading="lazy" />
            <span><strong>BUKKADOR</strong><small>HANDPAN</small></span>
          </a>
          <p>Handpan Live-Musik von Michael Noll.<br />Aus Worms. Für besondere Events überall in Deutschland.</p>
          <nav class="footer-social" aria-label="Bukkador auf Social Media">
            {socialLinks.map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={`Bukkador auf ${link.label}`}>
              {link.icon === 'instagram'
                ? <svg class="icon-instagram" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="4.5" /><circle cx="12" cy="12" r="4" /><circle cx="17.4" cy="6.7" r="1" /></svg>
                : link.icon === 'youtube'
                  ? <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21.3 7.2a2.8 2.8 0 0 0-2-2C17.6 4.7 12 4.7 12 4.7s-5.6 0-7.3.5a2.8 2.8 0 0 0-2 2A29 29 0 0 0 2.2 12a29 29 0 0 0 .5 4.8 2.8 2.8 0 0 0 2 2c1.7.5 7.3.5 7.3.5s5.6 0 7.3-.5a2.8 2.8 0 0 0 2-2 29 29 0 0 0 .5-4.8 29 29 0 0 0-.5-4.8Z" /><path class="icon-cutout" d="m10 15.5 5-3.5-5-3.5v7Z" /></svg>
                  : <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path class="icon-cutout" d="M7.7 9.9c2.6-1 6.7-.8 8.4.2M7.2 12.7c2.7-1 7.3-.8 9 .3M8 15.3c2.2-.7 5.4-.6 7 .3" /></svg>}
              <span>{link.label}</span>
            </a>)}
          </nav>
        </div>
        <div class="footer-links">
          <div><strong>Entdecken</strong><a href={path('/corporate-events/')}>Corporate Events</a><a href={path('/hochzeiten/')}>Hochzeiten</a><a href={path('/eventagenturen/')}>Eventagenturen</a><a href={path('/referenzen/')}>Referenzen & Events</a></div>
          <div><strong>Bukkador</strong><a href={path('/ueber-bukkador/')}>Über Michael</a><a href={path('/academy/')}>Academy</a><a href={path('/event-kuenstler-rhein-neckar/')}>Rhein-Neckar</a><a href={path('/event-kuenstler-rhein-main/')}>Rhein-Main</a></div>
          <div><strong>Kontakt</strong><a href={path('/kontakt/')}>Event-Angebot anfragen</a><a href={`mailto:${site.email}`}>{site.email}</a><a href={site.phoneHref}>{site.phone}</a></div>
        </div>
      </div>
      <div class="shell footer-bottom"><span>© {new Date().getFullYear()} Michael Noll · Bukkador Handpan</span><nav aria-label="Rechtliches"><a href={path('/impressum/')}>Impressum</a><a href={path('/datenschutz/')}>Datenschutz</a><a href={path('/agb/')}>AGB</a></nav></div>
    </footer>
    <style>
      .footer-social{display:flex;flex-wrap:wrap;gap:.55rem 1rem;margin-top:1.4rem}
      .footer-social a{display:inline-flex;align-items:center;gap:.42rem;color:#bfc6ba;font-size:.72rem;transition:color .2s ease}
      .footer-social svg{width:18px;height:18px;fill:currentColor;stroke:none}
      .footer-social .icon-instagram{fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
      .footer-social .icon-cutout{fill:none;stroke:var(--ink);stroke-width:1.65;stroke-linecap:round;stroke-linejoin:round}
      .footer-social a:hover{color:var(--gold-light)}
      @media(max-width:700px){.footer-social{margin-top:1.15rem}}
    </style>
    <script>
      import '../scripts/motion';
      const menu = document.querySelector<HTMLElement>('[data-events-menu]');
      if (menu) {
        const trigger = menu.querySelector<HTMLButtonElement>('.events-trigger');
        const links = Array.from(menu.querySelectorAll<HTMLAnchorElement>('[role="menuitem"]'));
        let closeTimer: number | undefined;
        const isDesktop = () => window.matchMedia('(min-width: 1081px)').matches;
        const open = () => {
          if (!isDesktop() || !trigger) return;
          window.clearTimeout(closeTimer);
          menu.classList.add('is-open');
          trigger.setAttribute('aria-expanded', 'true');
        };
        const close = (restoreFocus = false) => {
          window.clearTimeout(closeTimer);
          menu.classList.remove('is-open');
          trigger?.setAttribute('aria-expanded', 'false');
          if (restoreFocus) trigger?.focus();
        };
        const queueClose = () => { closeTimer = window.setTimeout(() => close(), 140); };

        trigger?.addEventListener('click', () => menu.classList.contains('is-open') ? close() : open());
        menu.addEventListener('mouseenter', open);
        menu.addEventListener('mouseleave', queueClose);
        menu.addEventListener('focusin', open);
        menu.addEventListener('focusout', () => window.setTimeout(() => { if (!menu.contains(document.activeElement)) close(); }));
        document.addEventListener('pointerdown', (event) => { if (!menu.contains(event.target as Node)) close(); });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && menu.classList.contains('is-open')) { event.preventDefault(); close(true); }
        });
        trigger?.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowDown') { event.preventDefault(); open(); links[0]?.focus(); }
          if (event.key === 'ArrowUp') { event.preventDefault(); open(); links.at(-1)?.focus(); }
        });
        links.forEach((link, index) => link.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowDown') { event.preventDefault(); links[(index + 1) % links.length]?.focus(); }
          if (event.key === 'ArrowUp') { event.preventDefault(); links[(index - 1 + links.length) % links.length]?.focus(); }
          if (event.key === 'Home') { event.preventDefault(); links[0]?.focus(); }
          if (event.key === 'End') { event.preventDefault(); links.at(-1)?.focus(); }
        }));
      }
    </script>
  </body>
</html>
