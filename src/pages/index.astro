---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQList from '../components/FAQList.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import EventJourney from '../components/EventJourney.astro';
import { homeFaqs, images } from '../content/site';
const path = (value: string) => `${import.meta.env.BASE_URL}${value.replace(/^\//, '')}`;
const showreelSrc = import.meta.env.PUBLIC_SHOWREEL_SRC ?? '';
const steps = [
  { title: 'Empfang', text: 'Atmosphärische Live-Musik beim Eintreffen der Gäste.' },
  { title: 'Networking', text: 'Dezente Performance, die Gespräche begleitet.' },
  { title: 'Dinner', text: 'Mehrere Sets passend zum Ablauf.' },
  { title: 'Highlight', text: 'Ein bewusst gesetzter musikalischer Programmpunkt.' },
];
---
<BaseLayout title="Bukkador Handpan – Live-Musik für besondere Events" description="Professionelle Handpan Live-Performance von Michael Noll für Corporate Events, Eventagenturen und Hochzeiten. Rhein-Neckar, Rhein-Main und deutschlandweit." image={images.homeEvent.src}>
  <section class="home-hero">
    <div class="shell home-hero-grid">
      <div class="home-hero-copy"><h1><span>Ein Klang,</span><span>der bleibt.</span></h1><p>Handpan Live-Performance für Corporate Events, Hochzeiten und besondere Veranstaltungen.</p><div class="hero-actions"><a class="button button-gold" href={path('/kontakt/')}>Event-Verfügbarkeit prüfen <span class="arrow-icon" aria-hidden="true"></span></a><a class="text-link" href="#showreel">Showreel ansehen</a></div><span class="minor">2–4 Std. Eventbegleitung · Eigene Technik · Rhein-Neckar & Rhein-Main · deutschlandweit buchbar</span></div>
      <div class="home-hero-media"><!-- TODO: Replace with real Bukkador photography and showreel poster -->{showreelSrc ? <><video class="hero-video" autoplay muted playsinline loop preload="none" poster={path(images.artistWide.src)} aria-label="Bukkador Event-Showreel"><source src={showreelSrc} type="video/mp4" /></video><img class="hero-mobile-poster" src={path(images.artistWide.src)} alt={images.artistWide.alt} width="1600" height="584" /></> : <><img src={path(images.homeEvent.src)} srcset={`${path(images.homeEvent.src.replace('.webp', '-800.webp'))} 800w, ${path(images.homeEvent.src)} 1920w`} sizes="(max-width: 700px) 100vw, 57vw" alt={images.homeEvent.alt} data-placeholder="concept" width="1920" height="1080" fetchpriority="high" style={`--image-mobile-position:${images.homeEvent.mobilePosition}`} /><span class="hero-note">Konzeptbild · keine Bukkador-Referenz</span></>}</div>
    </div>
  </section>
  <section class="proof-strip"><div class="shell"><h2>Live erlebt bei</h2><p>Freigegebene Kunden- und Eventlogos werden hier ergänzt.</p><div class="proof-slots" aria-label="Referenzlogos folgen"><span>Referenz 01 · folgt</span><span>Referenz 02 · folgt</span><span>Referenz 03 · folgt</span></div><!-- TODO: Add approved client/event logos --></div></section>
  <section class="intro-band"><div class="shell intro-grid"><h2>Mehr als Hintergrundmusik.</h2><div><p>Der besondere Klang schafft eine Atmosphäre, an die sich Gäste erinnern. Mal trägt er ein Gespräch, mal wird er zum Mittelpunkt eines gemeinsamen Moments.</p><a class="text-link" href={path('/ueber-bukkador/')}>Michael Noll kennenlernen <span class="arrow-icon" aria-hidden="true"></span></a></div></div></section>
  <section class="feature-story"><div class="shell feature-story-grid"><div class="feature-story-image"><!-- TODO: Replace with real Bukkador event photography --><img src={path(images.eventAtmosphere.src)} srcset={`${path(images.eventAtmosphere.src.replace('.webp', '-800.webp'))} 800w, ${path(images.eventAtmosphere.src)} 1920w`} sizes="(max-width: 700px) 100vw, 55vw" alt={images.eventAtmosphere.alt} data-placeholder="concept" width="1920" height="1080" loading="lazy" decoding="async" style={`--image-mobile-position:${images.eventAtmosphere.mobilePosition}`} /><span class="concept-note">Konzeptbild · Eventatmosphäre</span></div><div class="feature-story-content"><h2>Musik im Moment.</h2><p>Ein Live-Act, der sich in den Ablauf einfügt und dem Raum eine eigene Stimmung gibt.</p><a class="text-link" href={path('/referenzen/')}>Referenzen & Events <span class="arrow-icon" aria-hidden="true"></span></a></div></div></section>
  <section class="audience-section section-space"><div class="shell"><h2>Für Ihren Anlass.</h2><div class="audience-grid"><a href={path('/corporate-events/')} class="audience-item"><img src={path(images.corporateReception.src)} srcset={`${path(images.corporateReception.src.replace('.webp', '-800.webp'))} 800w, ${path(images.corporateReception.src)} 1600w`} sizes="(max-width: 700px) 100vw, 55vw" alt={images.corporateReception.alt} data-placeholder="concept" width="1600" height="1067" loading="lazy" style={`--image-mobile-position:${images.corporateReception.mobilePosition}`} /><span class="concept-note">Konzeptbild</span><div><h3>Corporate Events</h3><p>Live-Musik für Empfänge, Firmenfeiern, Galas, Messen und Dinner-Events.</p><span class="text-link">Corporate Events entdecken <span class="arrow-icon" aria-hidden="true"></span></span></div></a><a href={path('/hochzeiten/')} class="audience-item"><img src={path(images.weddingReception.src)} srcset={`${path(images.weddingReception.src.replace('.webp', '-800.webp'))} 800w, ${path(images.weddingReception.src)} 1600w`} sizes="(max-width: 700px) 100vw, 45vw" alt={images.weddingReception.alt} data-placeholder="concept" width="1600" height="1067" loading="lazy" style={`--image-mobile-position:${images.weddingReception.mobilePosition}`} /><span class="concept-note">Konzeptbild</span><div><h3>Hochzeiten</h3><p>Ein besonderer Klang für Trauung, Sektempfang und Dinner.</p><span class="text-link">Hochzeiten entdecken <span class="arrow-icon" aria-hidden="true"></span></span></div></a><a href={path('/eventagenturen/')} class="audience-item"><img src={path(images.agencyBackstage.src)} srcset={`${path(images.agencyBackstage.src.replace('.webp', '-800.webp'))} 800w, ${path(images.agencyBackstage.src)} 1600w`} sizes="(max-width: 700px) 100vw, 45vw" alt={images.agencyBackstage.alt} data-placeholder="concept" width="1600" height="1067" loading="lazy" style={`--image-mobile-position:${images.agencyBackstage.mobilePosition}`} /><span class="concept-note">Konzeptbild</span><div><h3>Eventagenturen</h3><p>Ein zuverlässiger Live-Act mit eigener Technik und direkter Abstimmung.</p><span class="text-link">Für Eventagenturen <span class="arrow-icon" aria-hidden="true"></span></span></div></a></div></div></section>
  <EventJourney title="Musik, die sich Ihrem Event anpasst." steps={steps} />
  <section class="showreel-section section-space" id="showreel"><div class="shell"><div class="showreel-copy"><h2>Bukkador live erleben.</h2><p>{showreelSrc ? 'Ein Eindruck von Bukkadors Live-Performance.' : 'Ein echtes Event-Showreel wird ergänzt. Bis dahin zeigen die Bilder auf dieser Seite eine visuelle Konzeptidee; sie dokumentieren keinen Bukkador-Auftritt.'}</p></div><div class="showreel-frame"><!-- TODO: Replace with professional Bukkador event showreel and real event poster -->{showreelSrc ? <video controls playsinline preload="none" poster={path(images.artistWide.src)} aria-label="Bukkador Event-Showreel"><source src={showreelSrc} type="video/mp4" /></video> : <><img src={path(images.homeEvent.src)} srcset={`${path(images.homeEvent.src.replace('.webp', '-800.webp'))} 800w, ${path(images.homeEvent.src)} 1920w`} sizes="(max-width: 700px) 100vw, 90vw" alt={images.homeEvent.alt} data-placeholder="concept" width="1920" height="1080" loading="lazy" style={`--image-mobile-position:${images.homeEvent.mobilePosition}`} /><span class="concept-note">Showreel in Vorbereitung · Konzeptbild</span></>}</div></div></section>
  <section class="service-section section-space"><div class="shell service-grid"><h2>Alles aus einer Hand.</h2><div><p>Michael bringt Instrumente und ein eigenes MAUI-Soundsystem mit. Aufbau, Soundcheck, mehrere Sets und Abbau werden auf den Ablauf abgestimmt. Indoor oder Outdoor ist nach Prüfung der Rahmenbedingungen möglich.</p><ul class="service-list"><li>Eigene professionelle Technik</li><li>Direkte Abstimmung</li><li>Mehrere musikalische Sets</li><li>Deutschlandweit buchbar</li></ul></div></div></section>
  <section class="concepts-section section-space"><div class="shell"><h2>Ein Konzept für Ihren Ablauf.</h2><div class="concepts-list"><article><h3>Empfang</h3><p>Live-Musik für Ankunft und Networking.</p></article><article><h3>Eventbegleitung</h3><p>Mehrere Sets über verschiedene Veranstaltungsphasen.</p></article><article><h3>Individuelles Eventkonzept</h3><p>Musikalische Begleitung von Empfang, Dinner und ausgewählten Programmpunkten.</p></article></div><a class="text-link" href={path('/kontakt/')}>Eventkonzept anfragen <span class="arrow-icon" aria-hidden="true"></span></a></div></section>
  <section class="reference-teaser section-space"><div class="shell"><div><h2>Erlebte Momente. Bald hier.</h2><p>Eine freigegebene Event-Case-Study und Stimmen von Veranstaltern werden ergänzt. Bis dahin nennen wir keine unbelegten Auftraggeber oder Bewertungen.</p><a class="text-link" href={path('/referenzen/')}>Referenzen & Events ansehen <span class="arrow-icon" aria-hidden="true"></span></a></div><!-- TODO: Add approved case study, testimonials, client/event logos --></div></section>
  <section class="artist-band"><div class="artist-band-image"><img src={path(images.artistPortrait.src)} alt={images.artistPortrait.alt} width="900" height="1046" loading="lazy" decoding="async" /></div><div class="artist-band-copy"><h2>Hinter dem Klang: Michael Noll.</h2><p>Handpan-Artist aus Worms. Mit Bukkador verbindet er die besondere Klangfarbe seiner Instrumente mit einer persönlichen, aufmerksamen Performance.</p><a class="text-link" href={path('/ueber-bukkador/')}>Mehr über Bukkador <span class="arrow-icon" aria-hidden="true"></span></a></div></section>
  <FAQList items={homeFaqs} />
  <ClosingCTA title="Einen besonderen Klang für Ihr Event schaffen." cta="Event-Verfügbarkeit prüfen" />
</BaseLayout>
