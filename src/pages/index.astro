---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQList from '../components/FAQList.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import EventJourney from '../components/EventJourney.astro';
import EventList from '../components/EventList.astro';

import { homeFaqs, images } from '../content/site';
import { legacyEvents, getUpcoming } from '../content/events';
import { getEvents } from '../lib/sanity';

const path = (value: string) =>
  `${import.meta.env.BASE_URL}${value.replace(/^\//, '')}`;

const events = getUpcoming(await getEvents(legacyEvents), 3);

const steps = [
  {
    title: 'Empfang',
    text: 'Atmosphärische Live-Musik beim Eintreffen der Gäste.',
  },
  {
    title: 'Networking',
    text: 'Dezente Performance, die Gespräche begleitet.',
  },
  {
    title: 'Dinner',
    text: 'Mehrere Sets passend zum Ablauf.',
  },
  {
    title: 'Highlight',
    text: 'Ein bewusst gesetzter musikalischer Programmpunkt.',
  },
];
---

<BaseLayout
  title="Bukkador Handpan – Live-Musik für besondere Events"
  description="Professionelle Handpan Live-Performance von Michael Noll für Corporate Events, Eventagenturen und Hochzeiten. Rhein-Neckar, Rhein-Main und deutschlandweit."
  image={images.homeEvent.src}
>

  <!-- ========================================
       01 HERO
       ======================================== -->
  <section class="home-hero">

    <video
      class="home-hero-video"
      autoplay
      muted
      playsinline
      loop
      preload="metadata"
      poster={path(images.homeEvent.src)}
      aria-label="Bukkador Event-Showreel"
    >
      <source
        src={path('/videos/bukkador-hero-showreel-v3.mp4')}
        type="video/mp4"
      />
    </video>

    <div class="home-hero-shade" aria-hidden="true"></div>

    <div class="shell home-hero-grid">

      <div class="home-hero-copy">

        <h1>
          <span>Handpan Live-Musik</span>
          <span>für besondere Events.</span>
        </h1>

        <p>
          Handpan Live-Performance für Corporate Events, Hochzeiten und
          besondere Veranstaltungen.
        </p>

        <div class="hero-actions">

          <a
            class="button button-gold"
            href={path('/kontakt/')}
          >
            Event-Verfügbarkeit prüfen
            <span class="arrow-icon" aria-hidden="true"></span>
          </a>

          <a class="text-link" href="#showreel">
            Showreel ansehen
          </a>

        </div>

        <span class="minor">
          2–4 Std. Eventbegleitung · Eigene Technik ·
          Rhein-Neckar &amp; Rhein-Main · deutschlandweit buchbar
        </span>

      </div>

    </div>


    <!-- TRUST BAR -->
    <div class="shell hero-proof">

      <h2>Live erlebt bei</h2>

      <div
        class="proof-slots"
        aria-label="Verifizierte öffentliche Auftritte und Partner"
      >

        <span class="proof-mark proof-mark--hamburger">
          <strong>Hamburger Tor</strong>
        </span>

        <span class="proof-mark proof-mark--kulturnacht">
          <strong>
            Wormser<br />
            Kulturnacht
          </strong>
        </span>

        <span class="proof-mark proof-mark--dach">
          <strong>
            Dach<br />
            der Welten
          </strong>
        </span>

      </div>

    </div>

  </section>



  <!-- ========================================
       02 AKTUELLE TERMINE & REFERENZEN
       ======================================== -->
  <section class="home-events-section section-space">

    <div class="shell">

      <div class="current-events-heading">

        <div>

          <h2>Aktuelle Termine.</h2>

          <p>
            Konzerte, Workshops und besondere Begegnungen mit Bukkador.
          </p>

        </div>

        <a
          class="text-link"
          href={path('/referenzen/')}
        >
          Alle Termine &amp; Referenzen
          <span class="arrow-icon" aria-hidden="true"></span>
        </a>

      </div>

      <EventList events={events} compact />

    </div>

  </section>



  <!-- ========================================
       03 FÜR IHREN ANLASS
       ======================================== -->
  <section class="audience-section section-space">

    <div class="shell">

      <h2>Für Ihren Anlass.</h2>

      <div class="audience-grid">


        <!-- CORPORATE -->
        <a
          href={path('/corporate-events/')}
          class="audience-item"
        >

          <img
            src={path(images.corporateReception.src)}
            srcset={`${path(
              images.corporateReception.src.replace('.webp', '-800.webp')
            )} 800w, ${path(images.corporateReception.src)} 1600w`}
            sizes="(max-width: 700px) 100vw, 55vw"
            alt={images.corporateReception.alt}
            data-placeholder="concept"
            width="1600"
            height="1067"
            loading="lazy"
            style={`--image-mobile-position:${images.corporateReception.mobilePosition}`}
          />

          <span class="concept-note">
            Konzeptbild
          </span>

          <div>

            <h3>Corporate Events</h3>

            <p>
              Live-Musik für Empfänge, Firmenfeiern, Galas,
              Messen und Dinner-Events.
            </p>

            <span class="text-link">
              Corporate Events entdecken
              <span class="arrow-icon" aria-hidden="true"></span>
            </span>

          </div>

        </a>


        <!-- HOCHZEITEN -->
        <a
          href={path('/hochzeiten/')}
          class="audience-item"
        >

          <img
            src={path(images.weddingReception.src)}
            srcset={`${path(
              images.weddingReception.src.replace('.webp', '-800.webp')
            )} 800w, ${path(images.weddingReception.src)} 1600w`}
            sizes="(max-width: 700px) 100vw, 45vw"
            alt={images.weddingReception.alt}
            data-placeholder="concept"
            width="1600"
            height="1067"
            loading="lazy"
            style={`--image-mobile-position:${images.weddingReception.mobilePosition}`}
          />

          <span class="concept-note">
            Konzeptbild
          </span>

          <div>

            <h3>Hochzeiten</h3>

            <p>
              Ein besonderer Klang für Trauung,
              Sektempfang und Dinner.
            </p>

            <span class="text-link">
              Hochzeiten entdecken
              <span class="arrow-icon" aria-hidden="true"></span>
            </span>

          </div>

        </a>


        <!-- EVENTAGENTUREN -->
        <a
          href={path('/eventagenturen/')}
          class="audience-item"
        >

          <img
            src={path(images.agencyBackstage.src)}
            srcset={`${path(
              images.agencyBackstage.src.replace('.webp', '-800.webp')
            )} 800w, ${path(images.agencyBackstage.src)} 1600w`}
            sizes="(max-width: 700px) 100vw, 45vw"
            alt={images.agencyBackstage.alt}
            data-placeholder="concept"
            width="1600"
            height="1067"
            loading="lazy"
            style={`--image-mobile-position:${images.agencyBackstage.mobilePosition}`}
          />

          <span class="concept-note">
            Konzeptbild
          </span>

          <div>

            <h3>Eventagenturen</h3>

            <p>
              Ein zuverlässiger Live-Act mit eigener Technik
              und direkter Abstimmung.
            </p>

            <span class="text-link">
              Für Eventagenturen
              <span class="arrow-icon" aria-hidden="true"></span>
            </span>

          </div>

        </a>

      </div>

    </div>

  </section>



  <!-- ========================================
       04 EVENTABLAUF
       ======================================== -->
  <EventJourney
    title="Musik, die sich Ihrem Event anpasst."
    steps={steps}
  />



  <!-- ========================================
       05 SHOWREEL
       ======================================== -->
  <section
    class="showreel-section section-space"
    id="showreel"
  >

    <div class="shell">

      <div class="showreel-copy">

        <h2>Bukkador live erleben.</h2>

        <p>
          Ein Eindruck von Bukkadors Handpan Live-Performance.
        </p>

      </div>


      <div class="showreel-frame">

        <video
          controls
          playsinline
          preload="metadata"
          poster={path(images.artistWide.src)}
          aria-label="Bukkador Handpan Showreel"
        >
          <source
            src={path('/videos/bukkador-hero-showreel-v3.mp4')}
            type="video/mp4"
          />
        </video>

      </div>

    </div>

  </section>



  <!-- ========================================
       06 ALLES AUS EINER HAND
       ======================================== -->
  <section class="service-section section-space">

    <div class="shell service-grid">

      <h2>Alles aus einer Hand.</h2>

      <div>

        <p>
          Michael bringt Instrumente und ein eigenes MAUI-Soundsystem mit.
          Aufbau, Soundcheck, mehrere Sets und Abbau werden auf den Ablauf
          abgestimmt. Indoor oder Outdoor ist nach Prüfung der
          Rahmenbedingungen möglich.
        </p>

        <ul class="service-list">

          <li>
            Eigene professionelle Technik
          </li>

          <li>
            Direkte Abstimmung
          </li>

          <li>
            Mehrere musikalische Sets
          </li>

          <li>
            Deutschlandweit buchbar
          </li>

        </ul>

      </div>

    </div>

  </section>



  <!-- ========================================
       07 SPOTIFY / MUSIK
       ======================================== -->
  <section class="feature-story">

    <div class="shell feature-story-grid">


      <!-- SPOTIFY -->
      <div class="feature-story-image feature-story-spotify">

        <iframe
          src="https://open.spotify.com/embed/artist/0TbeDNlnNt5uRC2gk3Z6am?utm_source=generator&theme=0"
          width="100%"
          height="100%"
          frameborder="0"
          allowfullscreen
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"
          title="Bukkador auf Spotify"
        ></iframe>

      </div>


      <!-- TEXT -->
      <div class="feature-story-content">

        <h2>Musik im Moment.</h2>

        <p>
          Bukkadors Handpan-Musik auch abseits der Bühne erleben.
          Entdecken Sie den Klang hinter der Live-Performance auf Spotify.
        </p>

        <a
          class="text-link"
          href="https://open.spotify.com/artist/0TbeDNlnNt5uRC2gk3Z6am"
          target="_blank"
          rel="noopener noreferrer"
        >
          Auf Spotify anhören
          <span class="arrow-icon" aria-hidden="true"></span>
        </a>

      </div>

    </div>

  </section>



  <!-- ========================================
       08 ÜBER MICHAEL
       ======================================== -->
  <section class="artist-band">

    <div class="artist-band-image">

      <img
        src={path(images.artistPortrait.src)}
        alt={images.artistPortrait.alt}
        width="900"
        height="1046"
        loading="lazy"
        decoding="async"
      />

    </div>


    <div class="artist-band-copy">

      <h2>
        Hinter dem Klang: Michael Noll.
      </h2>

      <p>
        Handpan-Artist aus Worms. Mit Bukkador verbindet er
        die besondere Klangfarbe seiner Instrumente mit einer
        persönlichen, aufmerksamen Performance.
      </p>

      <a
        class="text-link"
        href={path('/ueber-bukkador/')}
      >
        Mehr über Bukkador
        <span class="arrow-icon" aria-hidden="true"></span>
      </a>

    </div>

  </section>



  <!-- ========================================
       09 FAQ
       ======================================== -->
  <FAQList items={homeFaqs} />



  <!-- ========================================
       10 FINAL CTA
       ======================================== -->
  <ClosingCTA
  title="Handpan selbst erleben."
  text="Neugierig aufs Handpan spielen? Entdecke die Bukkador Workshops und lerne die Handpan selbst kennen."
  academy={true}
  cta="Platz sichern"
/>

</BaseLayout>